# MongoDB Atlas (Prisma 6.19)
DATABASE_URL="mongodb+srv://<db_username>:<db_password>@cluster0.ipqnjjd.mongodb.net/nexo?appName=Cluster0"

# API security (generate a different random 32+ character value for each environment)
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# API and web origins
NODE_ENV="development"
PORT=3001
WEB_ORIGIN="http://localhost:3000"

# Redis (queues and rate limiting)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_ENABLED="false"

# Object storage (MinIO local)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="nexo-media"
S3_ACCESS_KEY="admin"
S3_SECRET_KEY="admin123"

# Optional services
FIREBASE_CREDENTIALS=""
GEMINI_API_KEY=""
